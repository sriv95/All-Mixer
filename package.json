{
  "name": "all-mixer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts && ENTRY=page vite build --config vite.content.config.ts && vite build --config vite.worklet.config.ts",
    "dev": "vite build --watch --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "fetch-model": "node scripts/fetch-model.mjs && PY=${PY:-.venv/bin/python} node scripts/fetch-mdx-model.mjs",
    "export-roformer": "uv run python scripts/export-roformer.py",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
