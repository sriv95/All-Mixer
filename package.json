{
  "name": "all-mixer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "dev": "vite build --watch --config vite.content.config.ts",
