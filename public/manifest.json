{
  "manifest_version": 3,
  "name": "All Mixer!",
  "version": "0.2.0",
  "description": "Volume boost and vocal/instrumental mixing on any site, plus synced lyrics on YouTube and YouTube Music.",
  "minimum_chrome_version": "120",
  "action": { "default_popup": "popup/popup.html", "default_title": "All Mixer!" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "web_accessible_resources": [
    { "resources": ["worklet/separator-worklet.js", "ml/ml.html"], "matches": ["<all_urls>"] }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["page-media-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
